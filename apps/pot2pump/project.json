{
  "name": "pot2pump",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pot2pump",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project pot2pump --web",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "options": {
        "outputPath": "apps/pot2pump/",
        "postcssConfig": "apps/pot2pump/postcss.config.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/pot2pump/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/pot2pump"],
      "options": {
        "jestConfig": "apps/pot2pump/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
