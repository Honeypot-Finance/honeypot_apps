{
  "name": "pot2pump",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pot2pump",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project pot2pump --web",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "options": {
        "outputPath": "apps/pot2pump/",
        "postcssConfig": "apps/pot2pump/postcss.config.js"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/pot2pump/test/jest.config.js"
      }
    }
  }
}
