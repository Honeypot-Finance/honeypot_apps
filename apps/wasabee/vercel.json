{
  "crons": [
    {
      "path": "/api/cron/update-pools-cache",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/update-vaults-cache",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}