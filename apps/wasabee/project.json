{
  "name": "wasabee",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wasabee",
  "projectType": "application",
  "tags": ["type:app", "scope:wasabee"],
  "implicitDependencies": ["hpot-sdk"],
  "// targets": "to see all targets run: nx show project wasabee --web",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "options": {
        "outputPath": "apps/wasabee/",
        "postcssConfig": "apps/wasabee/postcss.config.js",
        "exclude": ["**/*.test.*", "**/jest.setup.ts", "**/test-setup.tsx"]

      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/wasabee/**/*.{ts,tsx,js,jsx}"],
        "ignorePath": "apps/wasabee/.eslintignore"
      }
    },

    "test": {
      "executor": "@nx/jest:jest",


      "outputs": ["{workspaceRoot}/coverage/apps/wasabee"],
      "options": {
        "jestConfig": "apps/wasabee/test/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
