{
  "version": 2,
  "buildCommand": "node scripts/build-optimize.js",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NEXT_TELEMETRY_DISABLED": "1",
      "SENTRY_UPLOAD_SOURCEMAPS": "false",
      "SENTRY_DISABLE_TELEMETRY": "true",
      "NODE_OPTIONS": "--max-old-space-size=4096 --gc-interval=100"
    }
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "ulimits": {
        "nofile": 32768
      },
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=1024 --enable-source-maps"
      }
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
