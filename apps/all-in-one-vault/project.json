{
  "name": "all-in-one-vault",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/all-in-one-vault",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project all-in-one-vault --web",

  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "options": {
        "outputPath": "apps/all-in-one-vault",
        "postcssConfig": "apps/all-in-one-vault/postcss.config.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/all-in-one-vault/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/all-in-one-vault"],
      "options": {
        "jestConfig": "apps/all-in-one-vault/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}