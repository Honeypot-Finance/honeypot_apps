{
  "name": "all-in-one-vault",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/all-in-one-vault",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project all-in-one-vault --web",

  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "options": {
        "outputPath": "apps/all-in-one-vault",
        "postcssConfig": "apps/all-in-one-vault/postcss.config.js",
        "exclude": ["**/*.test.*", "**/jest.setup.ts", "**/test-setup.tsx"]
      }
    },

    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectName}"],
      "options": {
        "jestConfig": "apps/all-in-one-vault/test/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
