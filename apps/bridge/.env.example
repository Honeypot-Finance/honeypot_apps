# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
# Optional - falls back to default if not provided
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Navbar API URL (optional - defaults to https://honeypotfinance.xyz/api/navbar)
NEXT_PUBLIC_NAVBAR_API_URL=https://honeypotfinance.xyz/api/navbar

# App hostname for URL conversion (optional - defaults to bridge.honeypotfinance.xyz)
NEXT_PUBLIC_APP_HOSTNAME=bridge.honeypotfinance.xyz
