{
  "name": "leaderboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/leaderboard",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project leaderboard --web",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "options": {
        "outputPath": "apps/leaderboard",
        "postcssConfig": "apps/leaderboard/postcss.config.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/leaderboard/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/leaderboard"],
      "options": {
        "jestConfig": "apps/leaderboard/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}