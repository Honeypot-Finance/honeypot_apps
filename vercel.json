{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },
  "build": {
    "env": {
      "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org/",
      "NODE_OPTIONS": "--max-old-space-size=7168",
      "NEXT_TELEMETRY_DISABLED": "1",
      "GENERATE_SOURCEMAP": "false"
    }
  }
}
