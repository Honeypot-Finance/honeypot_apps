# Vercel ignore file - exclude these from build uploads to reduce memory usage

# Dependencies that will be reinstalled
node_modules/

# Build artifacts
.next/
# dist/ - Commented out because we need charting library dist files
out/
build/

# Cache directories
.nx/
.cache/
.turbo/
**/.next/cache/

# Test files
**/*.test.*
**/*.spec.*
**/test/
**/tests/
**/__tests__/
**/coverage/

# Development files
**/*.md
!README.md
.vscode/
.idea/

# Git
.git/
.gitignore

# Environment files (pull from Vercel instead)
.env.local
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Nx cache
.nx/cache/

# Storybook
**/storybook-static/
